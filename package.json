{
  "name": "bookshelf-api-interview",
  "version": "1.0.0",
  "description": "Layered REST API reference — library catalogue.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "npm run build && node dist/server.js",
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "express": "^5.1.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
